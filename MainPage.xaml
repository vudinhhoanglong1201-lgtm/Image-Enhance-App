<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Image_Enhance_App.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Phục Hồi Nét Ảnh AI"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Button x:Name="BtnSelect"
                    Text="Chọn Ảnh Từ Máy"
                    Clicked="OnSelectImageClicked"
                    BackgroundColor="#512BD4"
                    TextColor="White" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Ảnh Gốc" HorizontalOptions="Center" />
                    <Image x:Name="ImgOriginal" HeightRequest="220" Aspect="AspectFit" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Kết Quả AI" HorizontalOptions="Center" />
                    <Image x:Name="ImgEnhanced" HeightRequest="220" Aspect="AspectFit" />
                </VerticalStackLayout>
            </Grid>

            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" Color="#512BD4" HorizontalOptions="Center" />
            <Label x:Name="LblStatus" HorizontalOptions="Center" TextColor="Gray" />

            <Button x:Name="BtnEnhance"
                    Text="Phục Hồi Nét Ảnh"
                    Clicked="OnEnhanceImageClicked"
                    BackgroundColor="#2B0B98"
                    TextColor="White" />

            <Button x:Name="BtnSave"
                    Text="Lưu Ảnh Về Máy"
                    Clicked="OnSaveImageClicked"
                    IsEnabled="False"
                    BackgroundColor="#107C41"
                    TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>