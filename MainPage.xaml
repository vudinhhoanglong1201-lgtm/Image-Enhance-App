<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Image_Enhance_App.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Phục Hồi Nét Ảnh AI" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <!-- Nút chọn ảnh -->
            <Button Text="Chọn Ảnh Từ Máy" 
                    Clicked="OnSelectImageClicked" 
                    BackgroundColor="#512BD4" 
                    TextColor="White" />

            <!-- Danh sách ảnh đã chọn / kết quả -->
            <CollectionView x:Name="ImagesList" HeightRequest="350">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="0" CornerRadius="8" IsClippedToBounds="True" HeightRequest="160">
                            <Image Source="{Binding .}" Aspect="AspectFill" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="LblStatus" 
                   Text="Chưa chọn ảnh nào" 
                   HorizontalOptions="Center" 
                   TextColor="Gray" />

            <ActivityIndicator x:Name="LoadingSpinner" 
                               IsRunning="False" 
                               IsVisible="False" 
                               Color="#512BD4" />

            <!-- Nút xử lý AI -->
            <Button x:Name="BtnEnhance" 
                    Text="Phục Hồi Nét Ảnh" 
                    Clicked="OnEnhanceImageClicked" 
                    BackgroundColor="#512BD4" 
                    TextColor="White" />

            <!-- Nút lưu ảnh -->
            <Button x:Name="BtnSave" 
                    Text="Lưu Ảnh Về Máy" 
                    Clicked="OnSaveImageClicked" 
                    IsEnabled="False" 
                    BackgroundColor="#512BD4" 
                    TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>